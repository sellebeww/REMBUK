# Salin ke .env.local (tidak di-commit) bila ingin mode Supabase. Tanpa nilai ini aplikasi berjalan di mode demo (data fiktif lokal).
# Hanya URL proyek dan kunci ANON (publik) yang dipakai peramban. JANGAN pernah menaruh service role key di sini atau di repo.
REMBUK_SUPABASE_URL=
REMBUK_SUPABASE_ANON_KEY=
